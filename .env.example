# API base URL for the Next.js backend.
# Dev (emulator): keep localhost:3000 and run `adb reverse tcp:3000 tcp:3000`.
# Dev (physical phone via Expo Go): use your PC's LAN IP, e.g. http://192.168.100.237:3000
# Prod: your deployed URL, e.g. https://inventory.ebright.my
EXPO_PUBLIC_API_URL=https://inventory.ebright.my
