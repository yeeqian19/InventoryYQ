generator client {
  provider        = "prisma-client-js"
  output          = "../lib/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model inventory_distribution_new {
  student_id            Int       @id @default(autoincrement())
  doc_no                String?   @db.VarChar(255)
  doc_date              DateTime? @db.Timestamp(6)
  branch_code           String?   @db.VarChar(50)
  student_name          String?   @db.VarChar(255)
  package               String?   @db.VarChar(50)
  type                  String?   @db.VarChar(50)
  sk_prep               Boolean   @default(false)
  sk_prep_date          DateTime? @db.Timestamp(6)
  eg_prep               Boolean   @default(false)
  eg_prep_date          DateTime? @db.Timestamp(6)
  bm_pickup             Boolean   @default(false)
  bm_pickup_date        DateTime? @db.Timestamp(6)
  student_received      Boolean   @default(false)
  student_received_date DateTime? @db.Timestamp(6)
  remark                String?   @db.VarChar(255)
  proof_photo           String?
  bm_pickup_photo       String?
  is_active             Boolean   @default(true)
  hq_prep_extension_days     Int  @default(0)
  bm_pickup_extension_days   Int  @default(0)
  bm_handover_extension_days Int  @default(0)
  barcode_sk            String?   @unique(map: "uniq_barcode_sk", where: raw("(barcode_sk IS NOT NULL)")) @default(dbgenerated("(((branch_code)::text || '-SK-'::text) || (student_id)::text)")) @db.VarChar
  barcode_eg            String?   @unique(map: "uniq_barcode_eg", where: raw("(barcode_eg IS NOT NULL)")) @default(dbgenerated("\nCASE\n    WHEN ((package)::text ~~* '12M%'::text) THEN (((branch_code)::text || '-EG-'::text) || (student_id)::text)\n    ELSE NULL::text\nEND")) @db.VarChar(255)

  @@unique([doc_no, student_name])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id            Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(255)
  password_hash String
  role          Role      @default(USER_RM)
  branch_name   String?   @db.VarChar(100)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  name          String?
  branchId      String?   @db.VarChar(100)
}

model ScanLog {
  id           String   @id @default(uuid())
  timestamp    DateTime @default(now())
  doc_no       String?
  barcode      String
  student_name String
  item_type    String
  branch       String
  action_type  String
  processed_by String

  @@map("scan_log")
}

model Inventory {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  currentCount  Int      @default(0)
  threshold     Int      @default(0)
  link          String?
  isSkPart      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  inCartCount   Int      @default(0)
  orderedCount  Int      @default(0)
  category      String   @default("SK_ITEM")
  neededCount   Int      @default(0)
  supplierEmail String?
}

model StarterKit {
  id           String  @id @default(cuid())
  packedCount  Int     @default(0)
  branchId     String?
  namedCount   Int     @default(0)
  unnamedCount Int     @default(0)
}

model deleted_invoices {
  student_id   Int       @id @default(autoincrement())
  doc_no       String?   @db.VarChar(255)
  doc_date     DateTime? @db.Timestamp(6)
  branch_code  String?   @db.VarChar(50)
  student_name String?   @db.VarChar(255)
  package      String?   @db.VarChar(50)
  type         String?   @db.VarChar(50)
  deleted_at   DateTime? @default(now()) @db.Timestamp(6)
  deleted_by   String?   @default(dbgenerated("CURRENT_USER"))

  @@unique([doc_no, student_name])
}

enum Role {
  SUPERADMIN
  ADMIN_HQ
  USER_RM
  USER_BM
}

/// Marketing item catalog (Certificate, Medal, Sash, Microphone + any custom items).
/// Per-event sub-rows come from:
///   - `grades`   — numeric breakdown (e.g. Medal: [1..8])
///   - `branches` — text breakdown (e.g. Sash: ['ST','BTHO',...])
/// Empty = single row per event. An item should use grades OR branches, not both.
/// `returnable` = true for items that come back after the event (Sash). Their
/// closing_stock formula skips consumption (= in_stock + ordered).
model fa_marketing_items {
  id          String                    @id @default(uuid()) @db.Uuid
  name        String                    @unique @db.VarChar(255)
  is_default  Boolean                   @default(false)
  grades      String[]                  @default([])
  branches    String[]                  @default([])
  returnable  Boolean                   @default(false)
  created_at  DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime                  @default(now()) @updatedAt @db.Timestamptz(6)
  inventory   fa_marketing_inventory[]
}

/// Per-event per-item-per-grade inventory. event_id is a soft reference to
/// fa_events.id in ebrightleads_db (cross-DB, no FK constraint).
/// `grade` is NULL for items without a grade breakdown.
/// Uniqueness is enforced by a NULLS NOT DISTINCT index created in marketing_grades.sql.
model fa_marketing_inventory {
  id              String              @id @default(uuid()) @db.Uuid
  event_id        String              @db.Uuid
  item_id         String              @db.Uuid
  grade           String?
  branch          String?
  in_stock        Int                 @default(0)
  /// True when the user explicitly typed in_stock; false when the system set
  /// it via auto-carry-forward. Auto-carry only updates rows where this is false.
  in_stock_manual Boolean             @default(false)
  /// For returnable items only. NULL = use derived value (in_stock for total_to_bring,
  /// in_stock + ordered for closing_stock). When set, overrides the derivation.
  total_to_bring_set        Int?
  /// Mirrors in_stock_manual: true when user typed the value, false when auto-carry set it.
  total_to_bring_set_manual Boolean @default(false)
  closing_stock_set         Int?
  registered      Int                 @default(0)
  buffer      Int                 @default(0)
  in_cart     Int                 @default(0)
  ordered     Int                 @default(0)
  no_show     Int                 @default(0)
  walk_in     Int                 @default(0)
  created_at  DateTime            @default(now()) @db.Timestamptz(6)
  updated_at  DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  item        fa_marketing_items  @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@index([event_id])
}
