generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model inventory_distribution_new {
  student_id            Int       @id @default(autoincrement())
  doc_no                String?   @db.VarChar(255)
  doc_date              DateTime? @db.Timestamp(6)
  branch_code           String?   @db.VarChar(50)
  student_name          String?   @db.VarChar(255)
  package               String?   @db.VarChar(50)
  type                  String?   @db.VarChar(50)
  sk_prep               Boolean   @default(false)
  sk_prep_date          DateTime? @db.Timestamp(6)
  eg_prep               Boolean   @default(false)
  eg_prep_date          DateTime? @db.Timestamp(6)
  bm_pickup             Boolean   @default(false)
  bm_pickup_date        DateTime? @db.Timestamp(6)
  student_received      Boolean   @default(false)
  student_received_date DateTime? @db.Timestamp(6)
  barcode_sk            String?   @default(dbgenerated("(((branch_code)::text || '-SK-'::text) || lpad((student_id)::text, 6, '0'::text))")) @db.VarChar
  remark                String?   @db.VarChar(255)
  barcode_eg            String?   @default(dbgenerated("\nCASE\n    WHEN (((package)::text ~~* '9M%'::text) OR ((package)::text ~~* '12M%'::text)) THEN (((branch_code)::text || '-EG-'::text) || lpad((student_id)::text, 6, '0'::text))\n    ELSE NULL::text\nEND")) @db.VarChar(255)
  proof_photo           String?
  bm_pickup_photo       String?
  is_active             Boolean   @default(true)

  @@unique([doc_no, student_name])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id            Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(255)
  password_hash String
  role          Role      @default(USER_RM)
  branch_name   String?   @db.VarChar(100)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  name          String?
  branchId      String?   @db.VarChar(100)
}

model ScanLog {
  id           String   @id @default(uuid())
  timestamp    DateTime @default(now())
  doc_no       String?
  barcode      String
  student_name String
  item_type    String
  branch       String
  action_type  String
  processed_by String

  @@map("scan_log")
}

model Inventory {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  currentCount Int      @default(0)
  threshold    Int      @default(0)
  link         String?
  isSkPart     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  inCartCount  Int      @default(0)
  orderedCount Int      @default(0)
  category      String   @default("SK_ITEM")
  neededCount   Int      @default(0)
  supplierEmail String?
}

model StarterKit {
  id            String  @id @default(cuid())
  packedCount   Int     @default(0)
  branchId      String?
  namedCount    Int     @default(0)
  unnamedCount  Int     @default(0)
}

enum Role {
  SUPERADMIN
  ADMIN_HQ
  USER_RM
  USER_BM
}
